# ---------------- Supabase (placeholders only; never commit real values) ----------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key        # API ONLY. Never in the browser, never on Vercel.

# ---------------- API ----------------
API_PORT=4000                                    # local only; hosts provide PORT themselves
WEB_ORIGIN=http://localhost:3000                 # production: your site address(es), comma-separated
# ENABLE_DOCS=false                              # /docs is closed in production unless this is true

# ---------------- Web (public values only) ----------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_API_URL=http://localhost:4000        # production: the public API address

# ---------------- Optional: alerts outside the website (see docs/ALERTS.md) ----------------
# PUBLIC_WEB_URL=https://your-site.vercel.app         # used for the links inside the messages
# TELEGRAM_BOT_TOKEN=                                  # from @BotFather
# TELEGRAM_BOT_USERNAME=                               # the bot username, without @
# WHATSAPP_TOKEN=                                      # Meta WhatsApp Cloud API token (API only, never in the browser)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=                                   # name of your approved message template (one {{1}} variable)
# WHATSAPP_TEMPLATE_LANG=ar

# ---- Only when the API runs on Vercel (docs/DEPLOYMENT.md, section 'بدون فيزا') ----
# DISABLE_OUTBOX=true      # serverless has no background timer
# CRON_SECRET=             # lets an external scheduler call /internal/outbox/tick every minute
# NEXT_PUBLIC_MAX_UPLOAD_MB=4   # (in the WEB project) Vercel limits a request to ~4.5 MB
